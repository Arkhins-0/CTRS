# ── NeonDB ────────────────────────────────────────────────────────────────
# Pooled connection string (used by both apps at runtime)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Direct (unpooled) connection string (used by migrations + seed)
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require"

# ── Auth secrets (any long random strings) ────────────────────────────────
ADMIN_SESSION_SECRET="change-me-32-bytes-random"
FAN_SESSION_SECRET="change-me-32-bytes-random"
REVALIDATE_SECRET="change-me-32-bytes-random"

# ── App URLs ──────────────────────────────────────────────────────────────
SITE_URL="http://localhost:3001"
ADMIN_URL="http://localhost:3002"

# ── AWS S3 media storage ──────────────────────────────────────────────────
S3_BUCKET="my-bucket"
S3_REGION="ap-south-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Public base URL for objects (bucket website / public bucket / CloudFront)
S3_PUBLIC_URL="https://my-bucket.s3.ap-south-1.amazonaws.com"

# ── Seed ──────────────────────────────────────────────────────────────────
SEED_ADMIN_EMAIL="arkhinser@gmail.com"
SEED_ADMIN_PASSWORD="admin12345"
